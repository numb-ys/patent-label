;;; Real AutoCAD Core Console integration tests. ASCII source for log portability.
(defun bht:restore-settings ()
  (foreach item bht:saved-vars
    (vl-catch-all-apply 'setvar (list (car item) (cdr item))))
  (foreach item bht:saved-env
    ;; Python restores originally absent registry values exactly after process exit.
    (vl-catch-all-apply 'setenv (list (car item) (if (cdr item) (cdr item) ""))))
  (princ))

(defun bht:on-error (message)
  (bht:restore-settings)
  (princ (strcat "\nTEST ABORTED: " message))
  (princ))

(defun bht:write (message / stream)
  (setq stream (open (strcat bht:output "/results.txt") "a"))
  (write-line message stream)
  (close stream)
  (princ (strcat "\n" message)))

(defun bht:assert (condition name)
  (if condition
    (progn (setq bht:passed (1+ bht:passed)) (bht:write (strcat "PASS " name)))
    (progn (setq bht:failed (1+ bht:failed)) (bht:write (strcat "FAIL " name))))
  condition)

(defun bht:case (name function / result)
  (setq result (vl-catch-all-apply function nil))
  (if (vl-catch-all-error-p result)
    (progn
      (bht:assert nil name)
      (bht:write (strcat "DETAIL " (vl-catch-all-error-message result))))))

(defun bht:point= (left right)
  (and left right (< (distance left right) 0.000001)))

(defun bht:vertices (entity / record child points)
  (setq record (tblobjname "BLOCK" (cdr (assoc 2 (entget entity))))
        child (entnext record))
  (while (and child (/= (cdr (assoc 0 (entget child))) "ENDBLK"))
    (if (= (cdr (assoc 0 (entget child))) "LWPOLYLINE")
      (foreach item (entget child)
        (if (= (car item) 10) (setq points (append points (list (cdr item)))))))
    (setq child (entnext child)))
  points)

(defun bht:world (entity point / data normal angle sx sy offset base)
  (setq data (entget entity) normal (cdr (assoc 210 data))
        angle (cdr (assoc 50 data)) sx (cdr (assoc 41 data)) sy (cdr (assoc 42 data))
        base (cdr (assoc 10 data))
        offset (list (- (* (car point) sx (cos angle)) (* (cadr point) sy (sin angle)))
                     (+ (* (car point) sx (sin angle)) (* (cadr point) sy (cos angle)))
                     0.0))
  (trans (mapcar '+ base offset) normal 0))

(defun bht:count (/ selection)
  (if (setq selection (ssget "_X" '((0 . "INSERT") (-3 ("PATENT_LABEL")))))
    (sslength selection) 0))

(defun bht:number-count (number / selection index count)
  (setq selection (ssget "_X" '((0 . "INSERT") (-3 ("PATENT_LABEL")))))
  (setq index 0 count 0)
  (if selection
    (while (< index (sslength selection))
      (if (= (cdr (assoc 1 (entget (bh:attribute (ssname selection index))))) number)
        (setq count (1+ count)))
      (setq index (1+ index))))
  count)

(defun bht:basic (/ entity attribute data vertices)
  (bht:assert (not (bh:bold-p)) "new-label-regular-default")
  (bht:assert (bh:digits-p "001") "digits-leading-zero")
  (bht:assert (bh:digits-p "99999999999999999999999999999999") "digits-32-max")
  (bht:assert (not (bh:digits-p "")) "digits-empty-rejected")
  (bht:assert (not (bh:digits-p "12 3")) "digits-whitespace-rejected")
  (bht:assert (not (bh:digits-p "12a")) "digits-letter-rejected")
  (bht:assert (not (bh:digits-p "-1")) "digits-negative-rejected")
  (bht:assert (not (bh:digits-p "123456789012345678901234567890123")) "digits-too-long")
  (bht:assert (= (bh:increment "009") "010") "increment-preserve-zero")
  (bht:assert (= (bh:increment "99999999999999999999") "100000000000000000000") "increment-no-integer-overflow")
  (bht:assert (bh:identifier-p "123") "identifier-three-digit")
  (bht:assert (bh:identifier-p "A") "identifier-single-letter")
  (bht:assert (bh:identifier-p "A01") "identifier-letter-and-digits")
  (bht:assert (bh:identifier-p "12a") "identifier-lowercase-suffix")
  (bht:assert (not (bh:identifier-p "A 1")) "identifier-spaces-rejected")
  (bht:assert (not (bh:identifier-p "A\"1")) "identifier-quote-rejected")
  (bht:assert (= (bh:increment "A") "B") "increment-single-letter")
  (bht:assert (= (bh:increment "Z") "AA") "increment-letter-rollover")
  (bht:assert (= (bh:increment "az") "ba") "increment-lowercase-rollover")
  (bht:assert (= (bh:increment "A01") "A02") "increment-letter-prefix-preserved")
  (bht:assert (= (bh:increment "A99") "A100") "increment-mixed-overflow")
  (bht:assert (= (bh:increment "12A") "12B") "increment-trailing-letter")
  (bht:assert (equal (bh:point-result '(1430.59 1025.68 0.0)) '(1430.59 1025.68 0.0)) "plain-ui-point-accepted")
  (bht:assert (equal (bh:point-result '((1430.59 1025.68 0.0))) '(1430.59 1025.68 0.0)) "legacy-nested-ui-point-normalized")
  (bh:ensure-resources)
  (bht:assert (not (bh:geometry '(0.0 0.0 0.0) "1" 2.5 3.75 0.8)) "overlap-rejected")
  (setq entity (bh:make-label '(0.0 0.0 0.0) '(25.0 15.0 0.0) "001" '(2.5 3.75 0.8))
        bht:original entity attribute (bh:attribute entity)
        data (entget entity) vertices (bht:vertices entity))
  (bht:assert (bh:label-p entity) "insert-has-xdata")
  (bht:assert (= (cdr (assoc 0 data)) "INSERT") "insert-entity-type")
  (bht:assert (= (length vertices) 3) "leader-has-three-vertices")
  (bht:assert (bht:point= (bht:world entity (car vertices)) '(0.0 0.0 0.0)) "leader-target-exact")
  (bht:assert (bht:point= (trans (cdr (assoc 11 (entget attribute))) attribute 0) '(25.0 15.0 0.0)) "number-center-exact")
  (bht:assert (= (cdr (assoc 1 (entget attribute))) "001") "attribute-keeps-leading-zero")
  (bht:assert (= (cdr (assoc 7 (entget attribute))) "PATENT_LABEL_SIMHEI_REGULAR") "attribute-uses-simhei-regular-style")
  (bht:assert (= (cdr (assoc 72 (entget attribute))) 1) "attribute-horizontal-center")
  (bht:assert (= (cdr (assoc 74 (entget attribute))) 2) "attribute-vertical-middle")
  (bht:assert (equal (cdr (assoc 330 (entget attribute))) entity) "attribute-owned-by-insert")
  (bht:assert (cdr (assoc 330 data)) "insert-has-database-owner")
  (bht:assert (< (car (caddr vertices)) 0.0) "left-target-left-tail")
  (setq entity (bh:make-label '(80.0 0.0 0.0) '(55.0 15.0 0.0) "002" '(2.5 3.75 0.8))
        vertices (bht:vertices entity))
  (bht:assert (> (car (caddr vertices)) 0.0) "right-target-right-tail")
  (bht:assert (equal (cadr (cadr vertices)) (cadr (caddr vertices)) 0.000001) "tail-is-horizontal")
  (bht:assert (bh:geometry '(0.0 20.0 0.0) "3" 2.5 3.75 0.8) "vertical-placement-has-bend"))

(defun bht:ucs (/ entity expected center vertices attribute)
  (command-s "_.UCS" "_3point" '(100.0 50.0 7.0) '(100.0 51.0 7.0) '(99.0 50.0 7.0))
  (setq expected (trans '(0.0 0.0 0.0) 1 0)
        center (trans '(25.0 15.0 0.0) 1 0)
        entity (bh:make-label '(0.0 0.0 0.0) '(25.0 15.0 0.0) "103" '(2.5 3.75 0.8))
        vertices (bht:vertices entity) attribute (bh:attribute entity))
  (bht:assert (bht:point= (bht:world entity (car vertices)) expected) "rotated-translated-ucs-target")
  (bht:assert (bht:point= (trans (cdr (assoc 11 (entget attribute))) attribute 0) center) "rotated-translated-ucs-center")
  (command-s "_.UCS" "_World")
  (command-s "_.UCS" "_3point" '(0.0 0.0 40.0) '(1.0 0.0 40.0) '(0.0 0.0 41.0))
  (setq expected (trans '(5.0 5.0 0.0) 1 0)
        center (trans '(25.0 15.0 0.0) 1 0)
        entity (bh:make-label '(5.0 5.0 0.0) '(25.0 15.0 0.0) "104" '(2.5 3.75 0.8))
        vertices (bht:vertices entity) attribute (bh:attribute entity))
  (bht:assert (bht:point= (bht:world entity (car vertices)) expected) "tilted-ucs-target")
  (bht:assert (bht:point= (trans (cdr (assoc 11 (entget attribute))) attribute 0) center) "tilted-ucs-center")
  (command-s "_.UCS" "_World"))

(defun bht:copy-edit (/ original copy oldblock oldtail vertices attribute)
  (setq original bht:original oldblock (cdr (assoc 2 (entget original)))
        oldtail (caddr (bht:vertices original)))
  (command-s "_.COPY" original "" "_non" '(0.0 0.0 0.0) "_non" '(0.0 30.0 0.0))
  (setq copy (entlast))
  (bht:assert (= (cdr (assoc 2 (entget copy))) oldblock) "copy-initially-shares-definition")
  (bh:replace-number copy "12345678")
  (bht:assert (/= (cdr (assoc 2 (entget copy))) oldblock) "edit-detaches-copied-definition")
  (bht:assert (= (cdr (assoc 2 (entget original))) oldblock) "edit-preserves-original-definition")
  (bht:assert (= (cdr (assoc 1 (entget (bh:attribute original)))) "001") "edit-preserves-original-number")
  (bht:assert (= (cdr (assoc 1 (entget (bh:attribute copy)))) "12345678") "edit-updates-selected-number")
  (bht:assert (> (abs (car (caddr (bht:vertices copy)))) (abs (car oldtail))) "longer-number-moves-tail-outward")
  (bht:assert (bht:point= (bht:world copy (car (bht:vertices copy))) '(0.0 30.0 0.0)) "copied-target-retained-after-edit"))

(defun bht:weight (/ original copy)
  (setq original bht:original)
  (command-s "_.COPY" original "" "_non" '(0.0 0.0 0.0) "_non" '(0.0 50.0 0.0))
  (setq copy (entlast))
  (bh:set-weight copy "Bold")
  (bht:assert (= (cdr (assoc 7 (entget (bh:attribute copy)))) "PATENT_LABEL_SIMHEI_BOLD") "selected-label-can-be-bold")
  (bht:assert (= (cdr (assoc 7 (entget (bh:attribute original)))) "PATENT_LABEL_SIMHEI_REGULAR") "weight-change-preserves-copy-original")
  (bh:replace-number copy "W01")
  (bht:assert (= (cdr (assoc 7 (entget (bh:attribute copy)))) "PATENT_LABEL_SIMHEI_BOLD") "number-edit-preserves-chosen-weight")
  (bh:set-weight copy "Regular")
  (bht:assert (= (cdr (assoc 7 (entget (bh:attribute copy)))) "PATENT_LABEL_SIMHEI_REGULAR") "selected-label-can-return-to-regular")
  (bht:assert (bht:point= (bht:world copy (car (bht:vertices copy))) '(0.0 50.0 0.0)) "weight-change-preserves-leader-target"))

(defun bht:undo (/ undo-open undo-dirty first second before)
  (setq before (bht:count))
  (bh:begin-undo)
  (setq first (bh:make-label '(100.0 0.0 0.0) '(120.0 20.0 0.0) "201" '(2.5 3.75 0.8)))
  (bh:end-undo)
  (bh:begin-undo)
  (setq second (bh:make-label '(130.0 0.0 0.0) '(150.0 20.0 0.0) "202" '(2.5 3.75 0.8)))
  (bh:end-undo)
  (command-s "_.U")
  (bht:assert (and (entget first) (not (entget second))) "one-undo-removes-only-last-label")
  (bht:assert (= (bht:count) (1+ before)) "one-undo-keeps-earlier-labels")
  (setq before (bht:count))
  (bh:begin-undo)
  (bh:make-label '(160.0 0.0 0.0) '(180.0 20.0 0.0) "203" '(2.5 3.75 0.8))
  (bh:on-error "TEST injected creation failure")
  (bht:assert (= before (bht:count)) "error-handler-rolls-back-current-label")
  (bht:assert (not undo-open) "error-handler-closes-undo-group")
  (bh:begin-undo)
  (bh:rollback)
  (bht:assert (= before (bht:count)) "empty-rollback-preserves-earlier-labels"))

(defun bht:locked-layer (/ layer data before last result)
  (setq layer (tblobjname "LAYER" "PATENT_LABEL") data (entget layer)
        before (bht:count) last (entlast))
  (entmod (subst (cons 70 (logior 4 (cdr (assoc 70 data)))) (assoc 70 data) data))
  (setq result (vl-catch-all-apply 'bh:make-label
                 (list '(200.0 0.0 0.0) '(220.0 20.0 0.0) "401" '(2.5 3.75 0.8))))
  (entmod data)
  (bht:assert (vl-catch-all-error-p result) "locked-label-layer-rejected")
  (bht:assert (and (= before (bht:count)) (equal last (entlast))) "locked-layer-leaves-no-partial-label"))

(defun bht:paper (/ entity owner)
  (setvar "TILEMODE" 0)
  (setvar "CVPORT" 1)
  (setq entity (bh:make-label '(0.0 0.0 0.0) '(20.0 15.0 0.0) "301" '(2.5 3.75 0.8))
        owner (cdr (assoc 330 (entget entity))))
  (bht:assert (= (cdr (assoc 67 (entget entity))) 1) "paper-space-label-created")
  (bht:assert (wcmatch (cdr (assoc 2 (entget owner))) "`*Paper_Space*") "paper-space-correct-owner")
  (setvar "TILEMODE" 1))

(defun bht:init ()
  (setq bht:passed 0 bht:failed 0)
  (setenv "PatentLabel.Bold" "Bold")
  (setenv "PatentLabel.SimHeiWeight" "")
  (setvar "CMDECHO" 0)
  (setvar "OSMODE" 0)
  (command-s "_.UNDO" "_Control" "_All")
  ;; SCRIPT itself opens an undo group; remove it for native operation tests.
  (command-s "_.UNDO" "_End")
  (command-s "_.UNDO" "_Auto" "_Off")
  (bht:write (strcat "HOST " (getvar "ACADVER") " LISPSYS=" (itoa (getvar "LISPSYS"))))
  (princ))

(defun bht:run ()
  (bht:init)
  (bht:case "basic-case-completed" 'bht:basic)
  (bht:case "ucs-case-completed" 'bht:ucs)
  (bht:case "copy-edit-case-completed" 'bht:copy-edit)
  (bht:case "undo-case-completed" 'bht:undo)
  (bht:case "locked-layer-case-completed" 'bht:locked-layer)
  (bht:case "paper-case-completed" 'bht:paper)
  (bht:finish))

(defun bht:finish ()
  (command-s "_.UCS" "_World")
  (setvar "TILEMODE" 1)
  (command-s "_.ZOOM" "_Extents")
  (bht:write (strcat "PERSIST_EXPECT " (itoa (bht:count))))
  (setvar "FILEDIA" 0)
  (command-s "_.SAVEAS" "_2018" (strcat bht:output "/verification.dwg"))
  (bht:write (strcat "SUMMARY " (itoa bht:passed) " " (itoa bht:failed)))
  (princ))

(defun bht:reopen (/ selection entity good count index attribute)
  (setq bht:passed 0 bht:failed 0)
  (setenv "PatentLabel.Bold" "Bold")
  (setenv "PatentLabel.SimHeiWeight" "")
  (setq selection (ssget "_X" '((0 . "INSERT") (-3 ("PATENT_LABEL")))))
  (setq count (if selection (sslength selection) 0) index 0 good T)
  (bht:assert (= count bht:expected) "save-reopen-label-count")
  (while (< index count)
    (setq entity (ssname selection index) attribute (bh:attribute entity))
    (if (not (and attribute (bh:identifier-p (cdr (assoc 1 (entget attribute))))
                  (= (length (bht:vertices entity)) 3)
                  (cdr (assoc 330 (entget entity)))))
      (setq good nil))
    (setq index (1+ index)))
  (bht:assert good "save-reopen-all-attributes-lines-and-owners")
  (bht:write (strcat "REOPEN_SUMMARY " (itoa bht:passed) " " (itoa bht:failed)))
  (princ))
(princ)
